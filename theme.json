{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"palette": [
				{
					"color": "#fffcf2",
					"name": "Cream",
					"slug": "custom-cream"
				},
				{
					"color": "#e2df2b",
					"name": "Light Green",
					"slug": "custom-light-green"
				},
				{
					"color": "#6d7637",
					"name": "Med Green",
					"slug": "custom-med-green"
				},
				{
					"color": "#464b34",
					"name": "Dark Green",
					"slug": "custom-dark-green"
				},
				{
					"color": "#c9e8ff",
					"name": "Light Blue",
					"slug": "custom-light-blue"
				},
				{
					"color": "#3a4740",
					"name": "Darker Green",
					"slug": "custom-darker-green"
				}
			]
		},
		"layout": {
			"contentSize": "800px",
			"wideSize": "1188px"
		},
		"spacing": {
			"units": [
				"%",
				"px",
				"em",
				"rem",
				"vh",
				"vw"
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
					"name": "System Font",
					"slug": "system-font"
				},
				{
					"fontFace": [
						{
							"fontFamily": "\"DM Serif Display\"",
							"fontStyle": "italic",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/dm-serif-display/dm-serif-display-400-italic.woff2"
							]
						},
						{
							"fontFamily": "\"DM Serif Display\"",
							"fontStyle": "normal",
							"fontWeight": "400",
							"src": [
								"file:./assets/fonts/dm-serif-display/dm-serif-display-400-normal.woff2"
							]
						}
					],
					"fontFamily": "\"DM Serif Display\", serif",
					"name": "DM Serif Display",
					"slug": "dm-serif-display"
				}
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"elements": {
			"button": {
				"color": {
					"background": "var(--wp--preset--color--custom-light-green)",
					"text": "var(--wp--preset--color--custom-darker-green)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-font)",
					"fontSize": "18px",
					"fontStyle": "normal",
					"fontWeight": "400",
					"letterSpacing": "0.36px"
				}
			},
			"h1": {
				"color": {
					"text": "var(--wp--preset--color--custom-light-green)"
				},
				"typography": {
					"fontSize": "120px"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "60px",
					"letterSpacing": "0px",
					"lineHeight": "0.36"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "40px",
					"lineHeight": "1.04"
				}
			},
			"h4": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-font)",
					"fontSize": "30px",
					"letterSpacing": "1.75px",
					"lineHeight": "1.88",
					"textTransform": "uppercase"
				}
			},
			"h5": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-font)",
					"fontSize": "25px",
					"fontStyle": "normal",
					"fontWeight": "300",
					"lineHeight": "1.76"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--system-font)",
					"fontSize": "16px",
					"letterSpacing": "1.6px",
					"lineHeight": "1.2"
				}
			},
			"heading": {
				"color": {
					"text": "var(--wp--preset--color--custom-dark-green)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--dm-serif-display)",
					"lineHeight": "1.2"
				}
			}
		},
		"spacing": {
			"padding": {
				"bottom": "0px",
				"left": "24px",
				"right": "24px",
				"top": "0px"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system-font)",
			"fontSize": "16px",
			"fontStyle": "normal",
			"fontWeight": "300",
			"letterSpacing": "-0.32px",
			"lineHeight": "1.75"
		}
	},
	"templateParts": [
		{
			"area": "header",
			"name": "header"
		},
		{
			"area": "footer",
			"name": "footer"
		}
	]
}