{
  "$schema": "https://schemas.wp.org/wp/7.1/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "color": {
      "custom": true,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#fffcf2",
          "name": "Cream",
          "slug": "cream"
        },
        {
          "color": "#e2df2b",
          "name": "Light Green",
          "slug": "light-green"
        },
        {
          "color": "#6d7637",
          "name": "Med Green",
          "slug": "med-green"
        },
        {
          "color": "#464b34",
          "name": "Dark Green",
          "slug": "dark-green"
        },
        {
          "color": "#3a4740",
          "name": "Darker Green",
          "slug": "darker-green"
        },
        {
          "color": "#c9e8ff",
          "name": "Light Blue",
          "slug": "light-blue"
        }
      ]
    },
    "layout": {
      "contentSize": "800px",
      "wideSize": "1188px"
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "spacingSizes": [
        {
          "name": "16",
          "size": "1rem",
          "slug": "16"
        },
        {
          "name": "24",
          "size": "clamp(0.75rem, calc(0.241rem + 1.695vw), 1.5rem)",
          "slug": "24"
        },
        {
          "name": "32",
          "size": "clamp(1.25rem, calc(0.742rem + 1.695vw), 2rem)",
          "slug": "32"
        },
        {
          "name": "48",
          "size": "clamp(2rem, calc(1.322rem + 2.26vw), 3rem)",
          "slug": "48"
        },
        {
          "name": "60",
          "size": "clamp(3rem, calc(2.491rem + 1.695vw), 3.75rem)",
          "slug": "60"
        },
        {
          "name": "76",
          "size": "clamp(3rem, calc(1.814rem + 3.955vw), 4.75rem)",
          "slug": "76"
        },
        {
          "name": "110",
          "size": "clamp(3rem, calc(0.373rem + 8.757vw), 6.875rem)",
          "slug": "110"
        },
        {
          "name": "160",
          "size": "clamp(3.125rem, calc(-1.536rem + 15.537vw), 10rem)",
          "slug": "160"
        }
      ],
      "units": ["px", "rem", "em", "%", "vw", "vh"]
    },
    "typography": {
      "defaultFontSizes": false,
      "fontSizes": [
        {
          "name": "H1",
          "slug": "heading-one",
          "size": "clamp(3.75rem, calc(1.208rem + 8.475vw), 7.50rem)"
        },
        {
          "name": "H2",
          "slug": "heading-two",
          "size": "clamp(1.88rem, calc(0.604rem + 4.237vw), 3.75rem)"
        },
        {
          "name": "H3",
          "slug": "heading-three",
          "size": "clamp(1.88rem, calc(1.451rem + 1.412vw), 2.50rem)"
        },
        {
          "name": "H4",
          "slug": "heading-four",
          "size": "clamp(1.00rem, calc(0.407rem + 1.977vw), 1.88rem)"
        },
        {
          "name": "H5",
          "slug": "heading-five",
          "size": "clamp(1.00rem, calc(0.619rem + 1.271vw), 1.56rem)"
        },
        {
          "name": "H6",
          "slug": "heading-six",
          "size": "clamp(0.88rem, calc(0.790rem + 0.282vw), 1.00rem)"
        },
        { "name": "Paragraph", "slug": "para", "size": "1rem" },
        {
          "name": "Button",
          "slug": "button-size",
          "size": "clamp(0.88rem, calc(0.706rem + 0.565vw), 1.13rem)"
        },
        {
          "name": "Mega Menu Item",
          "slug": "mega-menu-font-size",
          "size": "clamp(1.88rem, calc(-0.943rem + 9.393vw), 6.03rem)"
        }
      ],
      "fontFamilies": [
        {
          "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
          "name": "System Font",
          "slug": "system-font"
        },
        {
          "fontFace": [
            {
              "fontFamily": "\"DM Serif Display\"",
              "fontStyle": "italic",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/dm-serif-display/dm-serif-display-400-italic.woff2"
              ]
            },
            {
              "fontFamily": "\"DM Serif Display\"",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": [
                "file:./assets/fonts/dm-serif-display/dm-serif-display-400-normal.woff2"
              ]
            }
          ],
          "fontFamily": "\"DM Serif Display\", serif",
          "name": "DM Serif Display",
          "slug": "dm-serif-display"
        },
        {
          "fontFace": [
            {
              "fontFamily": "Gotham",
              "fontStyle": "normal",
              "fontWeight": "350",
              "src": ["file:./assets/fonts/gotham/gotham-350-normal.otf"]
            },
            {
              "fontFamily": "Gotham",
              "fontStyle": "normal",
              "fontWeight": "325",
              "src": ["file:./assets/fonts/gotham/gotham-325-normal.otf"]
            },
            {
              "fontFamily": "Gotham",
              "fontStyle": "normal",
              "fontWeight": "450",
              "src": ["file:./assets/fonts/gotham/gotham-450-normal.otf"]
            },
            {
              "fontFamily": "Gotham",
              "fontStyle": "italic",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/gotham/gotham-400-italic.otf"]
            },
            {
              "fontFamily": "Gotham",
              "fontStyle": "normal",
              "fontWeight": "400",
              "src": ["file:./assets/fonts/gotham/gotham-400-normal.otf"]
            }
          ],
          "fontFamily": "Gotham",
          "name": "Gotham",
          "slug": "gotham"
        }
      ]
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "text": "var(--wp--preset--color--dark-green)"
    },
    "elements": {
      "button": {
        "color": {
          "background": "var(--wp--preset--color--light-green)",
          "text": "var(--wp--preset--color--darker-green)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--gotham)",
          "fontSize": "var(--wp--preset--font-size--button-size)",
          "fontStyle": "normal",
          "fontWeight": "400",
          "letterSpacing": "0.36px"
        }
      },
      "h1": {
        "color": {
          "text": "var(--wp--preset--color--light-green)"
        },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--heading-one)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--heading-two)",
          "letterSpacing": "0px",
          "lineHeight": "0.36"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--heading-three)",
          "lineHeight": "1.04"
        }
      },
      "h4": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--gotham)",
          "fontSize": "var(--wp--preset--font-size--heading-four)",
          "letterSpacing": "1.75px",
          "lineHeight": "1.88",
          "textTransform": "uppercase"
        }
      },
      "h5": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--gotham)",
          "fontSize": "var(--wp--preset--font-size--heading-five)",
          "fontStyle": "normal",
          "fontWeight": "350",
          "lineHeight": "1.76"
        }
      },
      "h6": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--gotham)",
          "fontSize": "var(--wp--preset--font-size--heading-six)",
          "letterSpacing": "1.6px",
          "lineHeight": "1.2"
        }
      },
      "heading": {
        "color": {
          "text": "var(--wp--preset--color--dark-green)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--dm-serif-display)",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--dark-green)"
        }
      }
    },
    "spacing": {
      "blockGap": "var(--wp--preset--spacing--24)",
      "padding": {
        "bottom": "0px",
        "left": "24px",
        "right": "24px",
        "top": "0px"
      }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--gotham)",
      "fontSize": "16px",
      "fontStyle": "normal",
      "fontWeight": "350",
      "letterSpacing": "-0.32px",
      "lineHeight": "1.75"
    }
  },
  "templateParts": [
    {
      "area": "header",
      "name": "header"
    },
    {
      "area": "footer",
      "name": "footer"
    }
  ]
}
